# Required. Get it from @BotFather.
BOT_TOKEN=123456789:replace-with-your-token

# Optional. Comma-separated Telegram user IDs allowed to use /unban
# (get your ID from @userinfobot).
ADMIN_IDS=

# Optional. Telegram API reverse proxy (for example a Cloudflare Worker).
# The URL must contain the {0} and {1} placeholders.
# TELEGRAM_API_URL=https://your-worker.example.workers.dev/bot{0}/{1}
